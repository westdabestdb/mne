# ── Postgres (single DB for everything) ──────────────────────────────────────
# Cloud (Neon): postgresql://USER:PASS@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
# Local docker:  postgresql://mnemia:mnemia@localhost:5432/mnemia  (run: pnpm db:up)
DATABASE_URL=postgresql://mnemia:mnemia@localhost:5432/mnemia
# Only used by the local docker postgres (ignored for a cloud DATABASE_URL):
POSTGRES_USER=mnemia
POSTGRES_PASSWORD=mnemia
POSTGRES_DB=mnemia

# ── better-auth (web dashboard human session plane) ──────────────────────────
# REQUIRED in production: signs/encrypts sessions. Generate: openssl rand -hex 32
# Local/dev may leave empty (an insecure dev fallback is used, warned once).
BETTER_AUTH_SECRET=
# The dashboard's own origin (better-auth route base + cookie domain).
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Machine plane (REST API + MCP: mnem_live_ keys) ──────────────────────────
# Peppers the sha256 of every API key before storage. REQUIRED — an empty pepper defeats
# hashing, so the API refuses to boot without it. Generate: openssl rand -hex 32
# Must be IDENTICAL for the api app and the web app (web mints keys, api verifies them).
MNEMIA_API_KEY_PEPPER=
# Where the REST API listens / how the MCP reaches it.
API_PORT=8787
MNEMIA_API_URL=http://localhost:8787
# Where the API sends agents to approve a device (the web /connect page).
MNEMIA_WEB_URL=http://localhost:3000

NODE_ENV=development
