# ── Postgres (single DB for everything) ──────────────────────────────────────
# Cloud (Neon): postgresql://USER:PASS@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
# Local docker:  postgresql://mnemia:mnemia@localhost:5432/mnemia  (run: pnpm db:up)
DATABASE_URL=postgresql://mnemia:mnemia@localhost:5432/mnemia
# Only used by the local docker postgres (ignored for a cloud DATABASE_URL):
POSTGRES_USER=mnemia
POSTGRES_PASSWORD=mnemia
POSTGRES_DB=mnemia

# ── better-auth (web dashboard human session plane) ──────────────────────────
# REQUIRED in production: signs/encrypts sessions. Generate: openssl rand -hex 32
# Local/dev may leave empty (an insecure dev fallback is used, warned once).
BETTER_AUTH_SECRET=
# The dashboard's own origin (better-auth route base + cookie domain).
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

NODE_ENV=development
