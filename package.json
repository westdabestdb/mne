{
  "name": "mnemia",
  "version": "0.0.0",
  "private": true,
  "description": "Portable, shareable, correct agent memory — clean rebuild.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0",
    "pg": "^8.13.0",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "overrides": {
      "kysely": "0.28.17"
    }
  }
}
